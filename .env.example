# ============================================================================
# 播客情报库 / Podcast Intelligence — 环境变量配置示例
# 复制为 .env.local 并填入真实值。留空则自动进入 Mock Mode（内置演示数据）。
# ============================================================================

# --- Supabase ----------------------------------------------------------------
# 三个值都配置齐全后才会关闭 Mock Mode。
# 在 Supabase 项目设置 -> API 中获取。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用，拥有绕过 RLS 的权限，切勿暴露到浏览器或提交到仓库。
SUPABASE_SERVICE_ROLE_KEY=

# --- AI 内容分析：Anthropic Claude 或 DeepSeek 二选一 --------------------------------
# 两个都配置时优先用 Claude（目前对"绝不编造引用/时间点"这条要求验证得更充分）；
# 也可以用 AI_PROVIDER 强制指定为 anthropic / deepseek。DeepSeek 是 OpenAI 兼容接口，
# 每 token 价格比 Claude 便宜约 20~50 倍，建议先用同一集节目对比两边分析质量再决定。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5        # 可选，默认值如左
DEEPSEEK_API_KEY=                     # https://platform.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro        # 可选，默认值如左（deepseek-v4-flash 更便宜但准确率稍低）
AI_PROVIDER=                          # 可选：anthropic | deepseek，不填按上面两个 key 自动选择（Claude 优先）

# --- 音频转录：AssemblyAI / Groq / OpenAI 三选一 --------------------------------------
# 三个都配置时优先用 AssemblyAI（唯一支持长音频、直接传 URL 不用自己下载的）；
# 也可以用 TRANSCRIPTION_PROVIDER 强制指定为 assemblyai / groq / openai。

# AssemblyAI（推荐，尤其是长音频/多语言场景）：https://www.assemblyai.com
# 支持最长 10 小时 / 5GB 音频，直接提交音频 URL（不需要我们自己下载），异步处理 + Webhook 回调完成通知。
ASSEMBLYAI_API_KEY=
# 必填（用 AssemblyAI 时）：校验 Webhook 回调请求确实来自 AssemblyAI 的共享密钥，自己生成一个随机字符串即可，
# 例如 `openssl rand -hex 32`。
ASSEMBLYAI_WEBHOOK_SECRET=
# 可选：本应用对外可访问的地址，用于告诉 AssemblyAI 往哪里回调（例如 https://your-app.vercel.app）。
# 部署在 Vercel 上时会自动从 VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL 推断，一般不用手动填；
# 本地开发无法接收外部 Webhook（除非用 ngrok 等内网穿透工具），本地测试建议用下面的 Groq/OpenAI 同步方案。
APP_BASE_URL=

# Groq：https://console.groq.com/keys，价格约为 OpenAI 的 1/3 ~ 1/9，但单文件限 25MB/100MB
GROQ_API_KEY=
# OpenAI：https://platform.openai.com/api-keys，单文件限 25MB
OPENAI_API_KEY=

# 可选：assemblyai | groq | openai，不填则按上面几个 key 谁存在自动选择（AssemblyAI 优先）
TRANSCRIPTION_PROVIDER=
# 可选，覆盖 Groq/OpenAI 的默认模型（Groq 默认 whisper-large-v3，OpenAI 默认 whisper-1）
TRANSCRIPTION_MODEL=

# --- 本地推理（可选，只在跑模型的那台机器上配置）--------------------------------------
# 配置后，分析和转录会优先走本地模型；本地调用失败（服务没开、模型没加载等）会自动回退到
# 上面的云端 provider，不会让任务直接失败。
#
# 重要：这两组变量不要配到 Vercel 上。云端函数永远连不上你本机的 localhost，配了只会在每次
# 任务上白白耗掉一次连接超时。正确用法是本机的 .env.local 配、Vercel 不配 —— 在线网页照常
# 用云端 API，本地 worker 用本地模型。

# LM Studio（分析）：在 LM Studio 里 Developer → Start Server 后填这个地址。
# 注意模型加载时要把 context length 调到 32k 以上，播客转录稿动辄 2~3 万 token，默认 4k 必失败。
LMSTUDIO_BASE_URL=                    # 例如 http://localhost:1234/v1，不填则不启用本地分析
LMSTUDIO_MODEL=                       # 可选，默认 deepseek/deepseek-v4-flash
LMSTUDIO_API_KEY=                     # 可选，LM Studio 不校验，留空即可

# whisper.cpp（转录）：brew install whisper-cpp ffmpeg，再下载 ggml 模型文件。
# 本地转录没有云端 Whisper API 那个 25MB 上限，长节目可以直接本地转。
WHISPER_MODEL_PATH=                   # 例如 ~/.whisper-models/ggml-large-v3-turbo.bin，不填则不启用本地转录
WHISPER_CLI_PATH=                     # 可选，默认用 PATH 里的 whisper-cli
WHISPER_THREADS=                      # 可选，默认 8（主要影响 CPU 侧预处理，推理走 Metal）
WHISPER_LANGUAGE=                     # 可选，默认 auto；留空时优先用播客 RSS 里的语言标记，避免自动检测把中文节目误判成英文

# --- 账号 ------------------------------------------------------------------------
# 登录方式为手机号+密码（不依赖短信服务商，账号在 Supabase Auth 里用一个由手机号推导出的
# 占位邮箱创建，真实手机号存在 user_metadata / profiles.phone）。
# 可选：设置后注册时必须填对邀请码才能成功，适合"先小范围朋友测试"这个阶段；不填则任何人都能自助注册。
SIGNUP_INVITE_CODE=

# 后台管理（/admin/podcasts）的管理员手机号白名单，逗号分隔，例如 13800001111,13900002222。
# 未配置则任何人都无法进入后台（Mock Mode 下不受此限制，因为整个应用本来就只有一个演示用户）。
ADMIN_PHONES=

# --- 定时同步 -------------------------------------------------------------------
# 用于保护 /api/cron/sync 接口，Vercel Cron 触发时需带上
# Authorization: Bearer <CRON_SECRET> 请求头（或 ?secret= 查询参数）。
# 生产环境必须配置，否则该接口会拒绝所有请求。
CRON_SECRET=
